{
  "name": "AlphaInvest",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "trading_agent",
      "description": "Trading Agent autonomo con Claude Agent SDK",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/trading_agent",
      "dockerfile": "Dockerfile",
      "envVars": [
        {
          "name": "ANTHROPIC_MODEL",
          "value": "us.anthropic.claude-haiku-4-5-20251001-v1:0"
        },
        {
          "name": "AGENT_MAX_TURNS",
          "value": "10"
        },
        {
          "name": "AGENT_MAX_BUDGET_USD",
          "value": "0.25"
        },
        {
          "name": "AGENT_TIMEOUT_SECONDS",
          "value": "120"
        }
      ],
      "protocol": "HTTP",
      "requestHeaderAllowlist": [
        "Authorization"
      ],
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 900,
        "maxLifetime": 3600
      }
    }
  ],
  "memories": [
    {
      "name": "investor_memory",
      "description": "Preferencias y contexto del inversionista",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [
    {
      "name": "trading_quality",
      "agent": "trading_agent",
      "evaluators": [
        "Builtin.GoalSuccessRate",
        "Builtin.ToolSelectionAccuracy",
        "Builtin.Helpfulness"
      ],
      "samplingRate": 100,
      "description": "Calidad del Trading Agent: objetivo, herramientas y utilidad"
    }
  ],
  "agentCoreGateways": [
    {
      "name": "finance",
      "protocolType": "MCP",
      "description": "Herramientas financieras simuladas de AlphaInvest",
      "targets": [
        {
          "name": "finance-tools",
          "targetType": "lambda",
          "toolDefinitions": [
            {
              "name": "get_stock_price",
              "description": "Consulta el precio simulado y el cambio porcentual diario de una acción. Símbolos disponibles: AAPL, MSFT, NVDA. Datos ficticios para fines educativos.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string",
                    "description": "Símbolo bursátil, por ejemplo AAPL."
                  }
                },
                "required": [
                  "symbol"
                ]
              }
            },
            {
              "name": "get_portfolio",
              "description": "Devuelve el portafolio simulado compartido: posiciones, cantidades, valor de mercado, peso porcentual de cada posición, efectivo y valor total en USD.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              }
            },
            {
              "name": "simulate_trade",
              "description": "Ejecuta una operación de paper trading (nunca una operación real). Valida efectivo disponible, posiciones existentes, símbolos conocidos y un máximo de 1000 acciones por orden. Devuelve status FILLED o REJECTED con el motivo.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string",
                    "description": "Símbolo bursátil: AAPL, MSFT o NVDA."
                  },
                  "side": {
                    "type": "string",
                    "description": "BUY para comprar o SELL para vender, en mayúsculas."
                  },
                  "quantity": {
                    "type": "integer",
                    "description": "Número entero positivo de acciones."
                  }
                },
                "required": [
                  "symbol",
                  "side",
                  "quantity"
                ]
              }
            },
            {
              "name": "get_trade_history",
              "description": "Lista las operaciones simuladas más recientes, incluidas las rechazadas, con identificador, fecha, activo, cantidad y resultado.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "description": "Número de operaciones a devolver, entre 1 y 50. Por defecto 10."
                  }
                }
              }
            }
          ],
          "compute": {
            "host": "Lambda",
            "implementation": {
              "language": "Python",
              "path": "app/finance_tools",
              "handler": "handler.lambda_handler"
            },
            "pythonVersion": "PYTHON_3_12",
            "timeout": 15,
            "memorySize": 256
          }
        }
      ],
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": false,
      "exceptionLevel": "NONE",
      "policyEngineConfiguration": {
        "policyEngineName": "trading_guardrails",
        "mode": "ENFORCE"
      }
    }
  ],
  "policyEngines": [
    {
      "name": "trading_guardrails",
      "description": "Reglas deterministas para herramientas financieras",
      "policies": []
    }
  ],
  "configBundles": [],
  "harnesses": [
    {
      "name": "portfolio",
      "path": "app/portfolio"
    }
  ]
}