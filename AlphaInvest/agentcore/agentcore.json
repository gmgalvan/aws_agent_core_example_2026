{
  "name": "AlphaInvest",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "trading_agent",
      "description": "Trading Agent autonomo con Claude Agent SDK",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/trading_agent",
      "dockerfile": "Dockerfile",
      "envVars": [
        {
          "name": "ANTHROPIC_MODEL",
          "value": "us.anthropic.claude-haiku-4-5-20251001-v1:0"
        },
        {
          "name": "AGENT_MAX_TURNS",
          "value": "10"
        },
        {
          "name": "AGENT_MAX_BUDGET_USD",
          "value": "0.25"
        },
        {
          "name": "AGENT_TIMEOUT_SECONDS",
          "value": "120"
        }
      ],
      "protocol": "HTTP",
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 900,
        "maxLifetime": 3600
      }
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "harnesses": [
    {
      "name": "portfolio",
      "path": "app/portfolio"
    }
  ]
}
